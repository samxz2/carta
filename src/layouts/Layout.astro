---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Una carta para ti", description = "Una carta para ti." } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f1ec" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <!--
      Red de seguridad: si por cualquier motivo GSAP no carga,
      el sobre igualmente se puede abrir y la carta se muestra.
    -->
    <script is:inline>
      (function () {
        function reveal() {
          document.documentElement.classList.add("anim-fallback");
          var intro = document.getElementById("intro");
          if (intro) {
            intro.style.transition = "opacity .5s ease";
            intro.style.opacity = "0";
            window.setTimeout(function () {
              intro.style.display = "none";
            }, 600);
          }
          document.body.style.overflow = "";
        }

        document.addEventListener(
          "click",
          function (e) {
            if (window.__gsapReady) return;
            var t = e.target;
            if (t && t.closest && t.closest("#intro")) reveal();
          },
          true,
        );

        // Si tras 4s GSAP no arrancó, mostramos la carta de todos modos.
        window.addEventListener("load", function () {
          window.setTimeout(function () {
            if (!window.__gsapReady) reveal();
          }, 4000);
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
